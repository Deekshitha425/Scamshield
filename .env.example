# Copy this file to .env and fill in your own keys. Never commit the real .env.

# LLM provider (Groq — free tier, no credit card required)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Evidence tools
GOOGLE_SAFE_BROWSING_API_KEY=your-safe-browsing-key-here
VIRUSTOTAL_API_KEY=your-virustotal-key-here

# Retrieval
CHROMA_PERSIST_DIR=./data/chroma_store

# App
APP_ENV=development
MAX_RETRIEVAL_ROUNDS=2
